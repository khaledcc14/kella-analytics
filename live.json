<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KELLA Analytics Pro</title>
<style>
body { background: #0b0f19; color: #f8fafc; font-family: Arial, sans-serif; margin: 0; padding-bottom: 70px; }
.app-container { max-width: 480px; margin: 0 auto; padding: 10px; }
.top-header { display: flex; justify-content: space-between; align-items: center; padding: 5px 10px; }
.top-header h2 { color: #38bdf8; margin: 0; font-size: 18px; }
.match-card { background: #131b2e; border: 1px solid #1e293b; border-left: 4px solid #38bdf8; border-radius: 10px; padding: 12px; margin-bottom: 10px; font-size: 13px; }
</style>
</head>
<body>

<div class="app-container">
    <div class="top-header">
        <h2>KELLA Analytics Pro ⚽</h2>
        <span id="status">⏳ جاري التحميل...</span>
    </div>
    <div id="output"></div>
</div>

<script>
async function loadOriginalData() {
    try {
        const response = await fetch('https://raw.githubusercontent.com/khaledcc14/kella-analytics/main/live.json');
        const data = await response.json();
        
        let html = "";
        data.forEach(item => {
            let home = item.teams?.home?.name || "مضيف";
            let away = item.teams?.away?.name || "ضيف";
            let league = item.league?.name || "دوري";
            
            html += `
                <div class="match-card">
                    <div style="color:#38bdf8; font-weight:bold;">🏆 ${league}</div>
                    <div style="font-size:14px; font-weight:bold; margin-top:5px;">${home} vs ${away}</div>
                </div>
            `;
        });
        document.getElementById('output').innerHTML = html;
        document.getElementById('status').innerHTML = "🟢";
    } catch (e) {
        document.getElementById('status').innerHTML = "🔴";
        document.getElementById('output').innerHTML = "خطأ في تحميل الملف";
    }
}
loadOriginalData();
</script>

</body>
</html>
