name: Update Football Data On-Demand

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-data:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Run smart fetch script for fixtures
        run: |
          python -c '
          import urllib.request
          import json
          from datetime import datetime, timedelta

          api_key = "9089a8397ff28245938e358f0c9b5847"
          headers = {"x-apisports-key": api_key}

          def fetch_api(url):
              try:
                  req = urllib.request.Request(url, headers=headers)
                  with urllib.request.urlopen(req) as response:
                      return json.loads(response.read().decode())
              except Exception as e:
                  print("API Error:", e)
                  return None

          matches_list = []

          # 1. محاولة جلب المباريات المباشرة حالياً (Live All)
          data = fetch_api("https://v3.football.api-sports.io/fixtures?live=all")
          
          # 2. إذا ما كاينش مباريات مباشرة، نجلب مباريات اليوم بتوقيت الجزائر
          if not data or not data.get("response"):
              algeria_time = datetime.utcnow() + timedelta(hours=1)
              today_str = algeria_time.strftime("%Y-%m-%d")
              print(f"No live matches, fetching for date: {today_str}")
              data = fetch_api(f"https://v3.football.api-sports.io/fixtures?date={today_str}")

          if data and "response" in data:
              print(f"Found {len(data[\"response\"])} matches.")
              for item in data["response"]:
                  league = item.get("league", {}).get("name", "General")
                  home_team = item.get("teams", {}).get("home", {}).get("name", "Home")
                  away_team = item.get("teams", {}).get("away", {}).get("name", "Away")
                  goals_home = item.get("goals", {}).get("home", 0)
                  goals_away = item.get("goals", {}).get("away", 0)
                  fixture_status = item.get("fixture", {}).get("status", {})
                  status_short = fixture_status.get("short", "NS")
                  elapsed = fixture_status.get("elapsed", 0)
                  
                  fixture_date = item.get("fixture", {}).get("date", "")
                  match_time = "00:00"
                  if "T" in fixture_date:
                      match_time = fixture_date.split("T")[1][:5]

                  matches_list.append({
                      "league": league,
                      "homeTeam": home_team,
                      "awayTeam": away_team,
                      "homeGoals": goals_home if goals_home is not None else 0,
                      "awayGoals": goals_away if goals_away is not None else 0,
                      "status": status_short,
                      "elapsed": elapsed if elapsed else 0,
                      "time": match_time if status_short == "NS" else f"{elapsed}\x27"
                  })

          final_output = {"matches": matches_list}
          with open("live.json", "w", encoding="utf-8") as f:
              json.dump(final_output, f, ensure_ascii=False, indent=4)
          print("live.json updated successfully with", len(matches_list), "matches.")
          '

      - name: Commit and push changes safely
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add live.json
          git diff --quiet && git diff --staged --quiet || git commit -m "Update live.json with smart fetch [skip ci]"
          git push || echo "Push skipped or no changes"
