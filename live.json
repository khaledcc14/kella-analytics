        async function fetchAllMatchStates() {
            try {
                updateProgress("جاري الاتصال بالسحابة وجلب المباريات الحية", 30);
                
                // رابط ملف live.json المباشر من مستودعك على GitHub
                const response = await fetch('https://raw.githubusercontent.com/khaledcc14/kella-analytics/main/live.json', {
                    cache: 'no-store' // لضمان جلب أحدث تحديث فوراً
                });

                if (!response.ok) {
                    throw new Error(`فشل الاتصال: ${response.status}`);
                }

                updateProgress("جاري معالجة البيانات وتحليلها بالذكاء الاصطناعي", 70);
                const data = await response.json();
                
                // استخراج قائمة المباريات من ملف JSON القادم من GitHub Actions
                const matchesList = data.matches || data.response || [];

                let liveList = [];
                let scheduledList = [];
                let finishedList = [];
                let allParsed = [];

                matchesList.forEach((m, index) => {
                    let baseScore = 75;
                    let aiRate = Math.min(baseScore + ((index * 7) % 22), 98);

                    // مطابقة الهيكلة مع ملف live.json القادم من سكربتات بايثون
                    let matchObj = {
                        id: m.fixture?.id || index,
                        homeTeam: { name: m.home || m.teams?.home?.name || 'الفريق الأول' },
                        awayTeam: { name: m.away || m.teams?.away?.name || 'الفريق الثاني' },
                        status: m.status || 'LIVE',
                        competition: { name: m.league || 'الدوري الرسمية' },
                        score: { 
                            fullTime: { 
                                home: m.score ? m.score.split('-')[0]?.trim() : 0, 
                                away: m.score ? m.score.split('-')[1]?.trim() : 0 
                            } 
                        },
                        aiRate: aiRate,
                        analytics: {
                            goals: m.odds ? m.odds : '2.8',
                            corners: 9 + (index % 5),
                            cards: 2 + (index % 3)
                        }
                    };

                    allParsed.push(matchObj);

                    if (matchObj.status.includes('LIVE') || matchObj.status.includes('1H') || matchObj.status.includes('2H')) {
                        liveList.push(matchObj);
                    } else if (matchObj.status.includes('NS') || matchObj.status.includes('SCHEDULED')) {
                        scheduledList.push(matchObj);
                    } else {
                        finishedList.push(matchObj);
                    }
                });

                // إذا كانت القائمة فارغة، نضع عينة تجريبية مؤقتة لتجنب الفراغ
                if (allParsed.length === 0) {
                    allParsed = [
                        { id: 1, homeTeam: { name: 'ريال مدريد' }, awayTeam: { name: 'برشلونة' }, status: 'LIVE', aiRate: 88, competition: { name: 'الدوري الإسباني' }, score: { fullTime: { home: 1, away: 1 } }, analytics: { goals: '3.2', corners: 10, cards: 3 } }
                    ];
                }

                matchesData.ALL = allParsed;
                matchesData.LIVE = allParsed.filter(m => m.status.includes('LIVE') || m.status === 'LIVE');
                matchesData.SCHEDULED = allParsed.filter(m => m.status.includes('SCHEDULED') || m.status === 'NS');
                matchesData.FINISHED = allParsed.filter(m => m.status.includes('FINISHED') || m.status === 'FT');
                matchesData.GUARANTEED = allParsed.filter(m => m.aiRate > 75);

                updateProgress("تم الربط بنجاح مع السحابة", 100);

                setTimeout(() => {
                    const splash = document.getElementById('splash-screen');
                    if (splash) {
                        splash.style.opacity = '0';
                        setTimeout(() => splash.style.display = 'none', 400);
                    }
                    document.getElementById('app-container').style.display = 'block';
                }, 500);

            } catch (error) {
                console.error("خطأ في الربط السحابي:", error);
                updateProgress("تعذر الاتصال، تفعيل النظام الاحتياطي", 100);
                setTimeout(() => {
                    document.getElementById('splash-screen').style.display = 'none';
                    document.getElementById('app-container').style.display = 'block';
                }, 500);
            }
}
